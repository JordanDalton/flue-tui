# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required: the agents run on Claude (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional: a Tabfleet cloud browser for workers with the "browser" ability, and the
# TUI's /view pane (https://tabfleet.com). Without it, workers use web search only.
TABFLEET_API_KEY=

# Optional: required to reach the TUI's index route on anything but a local dev server.
# FLUE_TUI_TOKEN=
